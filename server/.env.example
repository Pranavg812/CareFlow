PORT=5000
MONGODB_URI=mongodb://localhost:27017/careflow
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173

# Optional - AI uses a safe fallback when omitted
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional - email logs to console when omitted
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CareFlow <no-reply@careflow.local>

# Optional - Google Calendar sync is skipped when omitted
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
